# Non-secret settings, loaded into every container as environment variables.
#
# Generated by kustomize with a content hash, so editing a value here rolls the
# pods. A plain ConfigMap would let a changed setting sit unapplied until some
# unrelated restart happened to pick it up.
TOME_LOG_FORMAT=json
TOME_LOG_LEVEL=info
TOME_BLOB_ROOT=/var/lib/tomekeeper
TOME_HTTP_ADDR=:8080
TOME_METRICS_ADDR=:9090
TOME_USERNAME=tome

# Served over HTTPS by the ingress controller, so the session cookie should
# refuse to travel in the clear. Set this to false only if you are deliberately
# serving plain HTTP: otherwise sign-in appears to succeed and then bounces
# straight back to the sign-in page, because the browser never stored the cookie.
TOME_COOKIE_SECURE=true

# TOME_CONTACT_URL is deliberately not here. It says who is running this rather
# than how the software behaves, so a value in the base would put one deployment's
# contact address on everybody's requests. Set it in your overlay — see
# deploy/overlays/example/kustomization.yaml — and see
# docs/explanation/politeness-and-rate-limiting.md for why it is worth setting.
