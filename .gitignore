# Build output
/bin/
/dist/

# Local overrides for development. Never commit real credentials.
.env
.env.local

# The blob archive root, if someone points it inside the work tree.
/archive/
/data/

# Editor and OS noise
.DS_Store
*.swp

# Per-developer tool settings. The shared ones, if any, are committed
# explicitly.
/.claude/settings.local.json

# Working documents, not shipped artifacts. Remove these lines if they should
# be published with the repository.
/docs/plan.md
/docs/pending-decisions.md

# Design work in progress. Logos, palettes, and mockups live here while they are
# still being decided; anything that becomes a shipped asset moves into
# internal/server/static/ and is committed there deliberately.
/design/
/logo-and-theme-*.png

# Real exports used to exercise the importers and measure the archive. These are
# a subscription list and a complete reading history — personal data that must
# never be published, and third-party article content besides. Anonymized
# fixtures for the test suite live under testdata/ and are committed there
# deliberately; nothing matching these patterns is a fixture.
/private/
/*.opml
/*.opml.xml
/wallabag*.json
/freshrss-*.json

# Real overlays. A hostname, a storage class and a cluster name are facts about
# someone's network, and this repository is public. deploy/overlays/example is
# the committed one; the working copy stays here.
/deploy/overlays/local/
