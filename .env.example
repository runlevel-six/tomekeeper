# Copy to .env and edit. Only the first three lines need a decision.
#
#   cp .env.example .env
#   docker compose up -d
#
# Every setting is documented in docs/reference/configuration.md; this file holds
# the handful that compose needs, and leaves the rest at their defaults.

# The database's own password. Nothing outside these containers uses it.
POSTGRES_PASSWORD=change-me

# Your sign-in password. Read only by the migration step, which is the only place
# the cleartext exists — the server authenticates against a stored hash and never
# sees this. Changing it here and running `docker compose up migrate` again is how
# you rotate it.
TOME_PASSWORD=change-me-too

# Published in the User-Agent of every outbound request, so an operator who wants
# this archiver to stop can find out who to ask. Strongly encouraged before
# pointing this at anyone else's server; a page of your own is fine.
TOME_CONTACT_URL=

# Keeps you signed in across restarts. Leave it empty and one is generated per
# process, which means every restart signs you out.
#
#   TOME_SESSION_KEY=$(openssl rand -base64 32)
TOME_SESSION_KEY=

# --- Everything below has a working default -----------------------------------

# Where the reader listens on your machine.
TOME_PORT=8080

# The sign-in name.
TOME_USERNAME=tome

# Cookies are marked Secure by default, and a browser will not send a Secure cookie
# over plain HTTP — so on http://localhost you would appear to sign in and then
# silently not be. Set this to true the moment there is TLS in front.
TOME_COOKIE_SECURE=false

# text is readable in a terminal; json is what you want if anything is collecting
# these logs.
TOME_LOG_FORMAT=text

# Image encoding costs about 600MB per picture, and the figure barely moves with
# image size — the cost is the call, not the pixels. Raise these two together or
# not at all: one without the other is how the worker gets killed mid-article.
TOME_IMAGE_CONCURRENCY=1
GOMEMLIMIT=1750MiB
TOME_WORKER_MEMORY=2g

# Which release to run. The compose file pins one, so this is only needed to move
# to another: releases are `vX.Y.Z`, `latest` is the newest of them, and `edge` is
# the tip of the default branch rather than a release.
#TOME_IMAGE=ghcr.io/runlevel-six/tomekeeper:v0.15.0
