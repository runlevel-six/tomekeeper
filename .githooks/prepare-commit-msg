#!/bin/sh
#
# Adds the DCO Signed-off-by trailer when it is missing.
#
# CONTRIBUTING.md requires a sign-off on every commit, and until this existed the
# requirement was a flag somebody had to remember: `git commit -s`. Remembering
# leaked — three of the eight commits before this hook was written had no
# trailer, including two release commits. This repository's habit is to check
# things rather than remember them (see scripts/check-release.sh), and a trailer
# is cheap enough to add on the way past.
#
# Passing -s as well is harmless: the trailer is only added when an identical one
# is not already there.
#
# Install with `task hooks:install`, which points core.hooksPath at this
# directory. Nothing here runs from a fresh clone until somebody does that —
# hooks are not, and should not be, executable code a clone runs on its own.

set -e

commit_msg_file=$1
commit_source=$2

# A merge commit's message is generated by git and is not the author's work to
# certify. `git merge --no-ff` on someone else's branch would otherwise sign off
# on their commits.
if [ "$commit_source" = "merge" ]; then
	exit 0
fi

# The identity git will actually use, rather than what `git config user.email`
# reports: this repository's author is selected by a conditional include on the
# remote URL, and the environment can override both. GIT_AUTHOR_IDENT resolves
# all of that the same way the commit will.
#
# It fails when no identity is configured at all, which is a problem for the
# commit itself to report — not for a hook to fail cryptically ahead of it.
ident=$(git var GIT_AUTHOR_IDENT) || exit 0

name=${ident%% <*}
email=${ident#*<}
email=${email%%>*}

if [ -z "$name" ] || [ -z "$email" ]; then
	exit 0
fi

# interpret-trailers rather than appending a line, because it knows where a
# trailer block ends, whether a blank line is needed, and to stay above the
# commented instructions and the verbose diff.
#
# addIfDifferent, not doNothing: an existing sign-off from a *different* person —
# a patch carried from someone else — should gain ours rather than suppress it.
# An identical one is never duplicated.
git interpret-trailers \
	--in-place \
	--if-exists addIfDifferent \
	--trailer "Signed-off-by: $name <$email>" \
	"$commit_msg_file"
